# --- Required ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# --- AI classifier (choose ONE backend below via CLASSIFIER_BACKEND) ---
# "gemini" is the recommended default: Google's free tier never expires,
# needs no credit card, and easily covers this bot's usage. Get a key at
# https://aistudio.google.com/apikey
CLASSIFIER_BACKEND=gemini
GEMINI_API_KEY=

# Only needed if you set CLASSIFIER_BACKEND=anthropic instead (note: new
# accounts get a one-time ~$5 credit that does NOT renew).
ANTHROPIC_API_KEY=

# --- Optional ---
FRED_API_KEY=
TWITTER_BEARER_TOKEN=
NEWSAPI_KEY=
FINNHUB_KEY=
RSSBRIDGE_URL=

# --- Tuning ---
POLL_INTERVAL_SECONDS=300
MIN_CONFIDENCE_TO_ALERT=0.55
MAX_ITEMS_PER_CYCLE=25
